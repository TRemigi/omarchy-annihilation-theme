#!/bin/bash

# Opt-in installer for the parts of Annihilation that `omarchy theme install`
# cannot carry (Hyprland Lua, Quickshell plugin). Everything is a symlink into
# this repo, nothing is copied, and nothing under /usr/share/omarchy is touched.
#
#   extras/install link      install the extras
#   extras/install unlink    remove them
#   extras/install status    show what is installed
#
#   extras/install notifications <command>   the optional themed notification daemon (a separate
#                            repo): status, add, update, enable, fallback, remove, auto. Run it
#                            with no command for the list; see extras/notifications-fork.

set -euo pipefail

REPO=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
CONFIG=$HOME/.config/omarchy
STATE=$HOME/.local/state/omarchy/current

PLUGIN_ID=annihilation.shimmer
PLUGIN_SRC=$REPO/extras/plugin/$PLUGIN_ID
PLUGIN_DST=$CONFIG/plugins/$PLUGIN_ID

HOOK_SRC=$REPO/extras/hooks/theme-set.sh
HOOK_DST=$CONFIG/hooks/theme-set.d/annihilation.sh
# Hooks that guard the optional notification fork; inert unless it is installed and enabled.
GUARD_HOOKS=(post-update post-boot)
STAGED_LUA=$STATE/theme/hyprland.lua
MARK="-- annihilation-extras"
MARKER=$HOME/.local/state/annihilation-theme/screensaver-off-by-us

current_theme() { cat "$STATE/theme.name" 2>/dev/null || echo none; }

# True when $1 is a symlink resolving to $2.
links_to() { [[ -L $1 && $(readlink -f "$1") == "$(readlink -f "$2")" ]]; }

reload_hyprland() { hyprctl reload >/dev/null 2>&1 || true; }

shell_running() { [[ $(timeout 2 omarchy-shell shell ping 2>/dev/null) == ok ]]; }

# link_hook [SRC DST]: the theme-set hook by default.
link_hook() {
  local src=${1:-$HOOK_SRC} dst=${2:-$HOOK_DST}
  mkdir -p "$(dirname "$dst")"
  if [[ -e $dst || -L $dst ]] && ! links_to "$dst" "$src"; then
    echo "refusing to replace $dst (not ours); move it aside and rerun" >&2
    return 1
  fi
  chmod +x "$src"
  ln -nsf "$src" "$dst"
  echo "hook      linked $dst"
}

unlink_hook() {
  local src=${1:-$HOOK_SRC} dst=${2:-$HOOK_DST}
  if links_to "$dst" "$src"; then
    rm "$dst"
    echo "hook      removed $dst"
  elif [[ -e $dst || -L $dst ]]; then
    echo "hook      left $dst alone (not ours)"
  fi
}

link_guard_hooks() {
  local h
  for h in "${GUARD_HOOKS[@]}"; do link_hook "$REPO/extras/hooks/$h.sh" "$CONFIG/hooks/$h.d/annihilation.sh" || true; done
}

unlink_guard_hooks() {
  local h
  for h in "${GUARD_HOOKS[@]}"; do unlink_hook "$REPO/extras/hooks/$h.sh" "$CONFIG/hooks/$h.d/annihilation.sh"; done
}

# Plugin discovery follows the symlink, but the shell's file watcher does not,
# so edits made in the repo need `omarchy-shell shell rescanPlugins`.
link_plugin() {
  mkdir -p "$(dirname "$PLUGIN_DST")"
  if [[ -e $PLUGIN_DST || -L $PLUGIN_DST ]] && ! links_to "$PLUGIN_DST" "$PLUGIN_SRC"; then
    echo "refusing to replace $PLUGIN_DST (not ours); move it aside and rerun" >&2
    return 1
  fi
  ln -nsf "$PLUGIN_SRC" "$PLUGIN_DST"
  echo "plugin    linked $PLUGIN_DST"

  if shell_running; then
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
    # The bar glyph goes after the workspaces; fall back to the manifest's
    # default section if that widget is not in the bar.
    if omarchy plugin enable "$PLUGIN_ID" --after omarchy.workspaces >/dev/null 2>&1 \
      || omarchy plugin enable "$PLUGIN_ID" >/dev/null 2>&1; then
      echo "plugin    enabled"
    else
      echo "plugin    could not enable; run: omarchy plugin enable $PLUGIN_ID" >&2
    fi
  else
    echo "plugin    shell not running; after login run: omarchy plugin enable $PLUGIN_ID"
  fi
}

unlink_plugin() {
  if shell_running; then omarchy plugin disable "$PLUGIN_ID" >/dev/null 2>&1 || true; fi
  if links_to "$PLUGIN_DST" "$PLUGIN_SRC"; then
    rm "$PLUGIN_DST"
    echo "plugin    removed"
    if shell_running; then omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true; fi
  elif [[ -e $PLUGIN_DST || -L $PLUGIN_DST ]]; then
    echo "plugin    left $PLUGIN_DST alone (not ours)"
  fi
}

# Put Omarchy's text screensaver back if the hook is what turned it off.
restore_screensaver() {
  [[ -x $HOOK_SRC ]] && "$HOOK_SRC" --restore
  [[ -f $MARKER ]] || echo "screensaver  stock restored (or never changed)"
}

# The hook only fires on `theme set`; run it now if annihilation is already
# the active theme so the extras show up without a theme switch.
apply_now() {
  [[ $(current_theme) == annihilation ]] && "$HOOK_SRC" annihilation || true
}

# Drop the dofile line the hook appended so unlink takes effect immediately
# rather than at the next theme switch.
strip_staged() {
  [[ -f $STAGED_LUA ]] && grep -qF -- "$MARK" "$STAGED_LUA" || return 0
  sed -i "/$MARK/d" "$STAGED_LUA"
  reload_hyprland
  echo "hyprland  extras removed from staged theme"
}

status() {
  if links_to "$PLUGIN_DST" "$PLUGIN_SRC"; then echo "plugin    linked"; else echo "plugin    not installed"; fi
  if links_to "$HOOK_DST" "$HOOK_SRC"; then echo "hook      linked"; else echo "hook      not installed"; fi
  local h
  for h in "${GUARD_HOOKS[@]}"; do
    if links_to "$CONFIG/hooks/$h.d/annihilation.sh" "$REPO/extras/hooks/$h.sh"; then echo "hook      $h linked (notification fork guard)"
    else echo "hook      $h not installed (notification fork guard)"; fi
  done
  if [[ -f $MARKER ]]; then echo "screensaver  stock text screensaver off (shimmer owns it)"; else echo "screensaver  stock"; fi
  if [[ -f $STAGED_LUA ]] && grep -qF -- "$MARK" "$STAGED_LUA"; then
    echo "hyprland  extras active in staged theme"
  else
    echo "hyprland  extras not loaded (theme: $(current_theme))"
  fi
  "$REPO/extras/notifications-fork" status --short
}

case ${1:-} in
  link) link_hook; link_guard_hooks; link_plugin; apply_now ;;
  unlink) strip_staged; unlink_plugin; restore_screensaver; unlink_hook; unlink_guard_hooks ;;
  status) status ;;
  notifications) shift; exec "$REPO/extras/notifications-fork" "$@" ;;
  *) echo "Usage: ${0##*/} link|unlink|status|notifications <command>" >&2; exit 1 ;;
esac
